# =============================================================================
# Hamareh SaaS ERP — Frontend environment (FE-P0-T15)
# Copy to .env.local for local development (never commit secrets).
# =============================================================================

# Backend API base URL — no trailing slash.
# Must match Backend route prefix that serves /identity-core/... and module APIs.
# Docker Backend default: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public origin of this Next.js app (used for absolute links / future OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: force a default theme ("light" | "dark" | "system"). Runtime still allows toggle.
# NEXT_PUBLIC_DEFAULT_THEME=light

# -----------------------------------------------------------------------------
# CORS / concurrent run with Backend (Docker)
# -----------------------------------------------------------------------------
# 1) Start Backend (example):
#      cd hamarehSaasErp && docker compose up -d
# 2) Ensure Backend CORS allows NEXT_PUBLIC_APP_URL origin (e.g. http://localhost:3000)
# 3) Frontend:
#      cp .env.example .env.local
#      pnpm install && pnpm dev
# 4) Open http://localhost:3000/login
#
# If the browser shows CORS errors, set Backend SANCTUM_STATEFUL_DOMAINS /
# CORS_ALLOWED_ORIGINS (or equivalent) to include localhost:3000.
# Tenant header injected by the client: X-Tenant-ID
# Auth header: Authorization: Bearer <access_token>
